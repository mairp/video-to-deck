# Copy to local.env (gitignored) and edit for your machine.
# drive_decks.sh sources it automatically if present.

# Command that authors one deck. The prompt is appended as the final argument,
# unless the command contains the literal {prompt}, which is substituted instead.
#V2D_AGENT_CMD="claude -p"
#V2D_AGENT_CMD="ollama run qwen3"
#V2D_AGENT_CMD="llm -m gpt-4o-mini"

# Optional vision pass (any OpenAI-compatible /chat/completions endpoint).
#VISION_MODEL=qwen2.5-vl
#VISION_ENDPOINT=http://127.0.0.1:8081/v1/chat/completions
#VISION_API_KEY=

# Transcription. WHISPER_DEVICE: auto|cuda|cpu   WHISPER_MODEL: tiny|base|small|medium|large-v3
#WHISPER_DEVICE=auto
#WHISPER_MODEL=base
