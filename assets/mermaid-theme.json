  "htmlLabels": false,
  "flowchart": { "curve": "basis", "htmlLabels": false, "padding": 14, "useMaxWidth": true },
  "sequence": { "useMaxWidth": true, "mirrorActors": false },
  "themeCSS": ".edgeLabel, .edgeLabel p { background-color: #0B0F14 !important; color: #C9D1D9 !important; } .edgeLabel rect { fill: #0B0F14 !important; opacity: 0.92; } .cluster-label .nodeLabel, .cluster-label p { color: #9DA7B0 !important; } .accent > rect, .accent > polygon, .accent > circle, .accent > path { fill: #14300A !important; stroke: #76B900 !important; stroke-width: 2px !important; } .accent .nodeLabel, .accent .nodeLabel p { color: #DBF3B0 !important; } .accentEdge { stroke: #76B900 !important; stroke-width: 2.5px !important; }"
}
